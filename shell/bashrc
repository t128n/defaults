# Bash profile — managed by t128n/dotfiles, edit shell/bashrc in the repo.

case $- in
    *i*) ;;
    *) return ;;
esac

export LANG=${LANG:-en_US.UTF-8}
export LC_ALL=${LC_ALL:-en_US.UTF-8}

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export AZURE_CORE_COLLECT_TELEMETRY=0

# Toolchain
command -v mise >/dev/null 2>&1 && eval "$(mise activate bash)"

# User executables
export PATH="$HOME/Workspace/Bin:$PATH"

# Window title + Starship prompt
update_host_title() {
    local title="$1"
    [ -z "$title" ] && title="bash: ${PWD/#$HOME/\~}"
    printf '\033]0;%s\007' "$title"
}

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    PS1='\u@\h \w\$ '
fi
PROMPT_COMMAND="update_host_title${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Readline ergonomics
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\e[1;5C": forward-word'
bind '"\e[1;5D": backward-word'
bind 'set show-all-if-ambiguous on'
bind 'TAB: menu-complete'

if command -v fzf >/dev/null 2>&1; then
    export FZF_DEFAULT_OPTS=${FZF_DEFAULT_OPTS:-'--color=bg+:#262626,bg:#161616,spinner:#ee5396,hl:#ee5396 --color=fg:#f2f4f8,header:#78a9ff,info:#08bdba,pointer:#3ddbd9 --color=marker:#33b1ff,fg+:#ffffff,prompt:#08bdba,hl+:#33b1ff --layout=reverse --border=rounded --height=40%'}
    [ -z "$RIPGREP_CONFIG_PATH" ] && [ -f "$HOME/.config/ripgrep/config" ] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

    __fzf_find_file() {
        local fd_cmd="git ls-files"
        command -v fd >/dev/null 2>&1 && fd_cmd="fd --type f --strip-cwd-prefix --hidden --exclude .git"
        local selected
        selected=$(eval "$fd_cmd" | fzf)
        [ -n "$selected" ] && READLINE_LINE="${READLINE_LINE}${selected}" && READLINE_POINT=${#READLINE_LINE}
    }
    bind -x '"\C-f": __fzf_find_file'

    __fzf_find_dir() {
        command -v fd >/dev/null 2>&1 || return
        local selected
        selected=$(fd --type d --strip-cwd-prefix --hidden --exclude .git | fzf)
        [ -n "$selected" ] && READLINE_LINE="${READLINE_LINE}${selected}" && READLINE_POINT=${#READLINE_LINE}
    }
    bind -x '"\e\C-f": __fzf_find_dir'
fi

# Git shortcuts
g()   { git "$@"; }
gst() { git status "$@"; }
gco() { git checkout "$@"; }
gsw() { git switch "$@"; }
gcb() { git checkout -b "$@"; }
gd()  { git diff "$@"; }
gl()  { git log --oneline --graph --decorate -n 20 "$@"; }
gcm() { git commit -m "$@"; }
gp()  { git push "$@"; }
gpl() { git pull "$@"; }

# Directory traversal & workspace navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

mkcd() { mkdir -p "$1" && cd "$1"; }

ws() {
    case "${1,,}" in
        repos)  cd "$HOME/Workspace/Repos" ;;
        portal) cd "$HOME/Workspace/Portal" ;;
        cache)  cd "$HOME/Workspace/Cache" ;;
        spikes) cd "$HOME/Workspace/Spikes" ;;
        setup)  cd "$HOME/Workspace/Setup" ;;
        *)      cd "$HOME/Workspace" ;;
    esac
}
portal() { cd "$HOME/Workspace/Portal"; }

is_admin() { [ "$(id -u)" -eq 0 ]; }
